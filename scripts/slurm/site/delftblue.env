# Cluster settings for DelftBlue (the default site). Sourced by
# scripts/slurm/*.sbatch and scripts/slurm/submit_sweep.sh when SLURM_SITE is
# unset or "delftblue"; source it yourself (`source scripts/slurm/site/
# delftblue.env`) before running scripts/stage_apptainer_images.py by hand.
#
# SBATCH_ACCOUNT / SBATCH_PARTITION are sbatch's own input environment
# variables: sbatch reads them as if they were --account / --partition, and
# command-line options still override them. The #SBATCH lines in the scripts
# carry the same DelftBlue values, so this file does not change anything for
# a DelftBlue submission; it exists so another site file can replace them.
: "${SBATCH_ACCOUNT:=research-eemcs-st}"
: "${SBATCH_PARTITION:=compute-p1}"
export SBATCH_ACCOUNT SBATCH_PARTITION

# Loaded after `module load 2026 cpu` (pyproject.toml needs Python >= 3.12).
export PYTHON_MODULE="${PYTHON_MODULE:-python/3.13.18}"

# SIF_CACHE_DIR is deliberately not set: docker_utils.DEFAULT_SIF_CACHE_DIR
# falls back to ~/apptainer-images, the DelftBlue convention.
