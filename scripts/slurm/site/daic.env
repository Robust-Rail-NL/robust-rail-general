# Cluster settings for DAIC (TU Delft's other HPC cluster). Select it with
# SLURM_SITE=daic, e.g. `SLURM_SITE=daic scripts/slurm/submit_sweep.sh ...`.
# Source it yourself (`source scripts/slurm/site/daic.env`) before running
# scripts/stage_apptainer_images.py by hand on the login node.
#
# Observed on DAIC, 2026-11-04 (login node daic01 and compute node gpu47):
#   - /usr/bin/apptainer 1.5.5 exists on login and compute nodes, no module.
#   - `module load 2026 cpu` makes python/3.13.12 available (system python is 3.9).
#   - DefMemPerNode is 1 (MB): always pass --mem-per-cpu, as the scripts do.
#   - Limits on this account: maxjobs 64, maxsubmit 1000. All nodes are GPU
#     nodes; a CPU-only job needs no --gres.
#   - /home/$USER has a 4 MiB quota. ~/linuxhome (a symlink to
#     /tudelft.net/staff-homes-linux/...) is writable from compute nodes.
#     There is no /scratch. Everything big must live under ~/linuxhome,
#     whose quota is 30 GiB soft / 32 GiB hard.
#   - ghcr.io answers (HTTP 405 on /v2/) from login and compute nodes.
# Not observed: any purge policy of ~/linuxhome.
#
# SBATCH_ACCOUNT / SBATCH_PARTITION are sbatch's own input environment
# variables (read as --account / --partition; command-line options and a
# value you export before sourcing this file still win).
: "${SBATCH_ACCOUNT:=daic-eemcs-st-algor}"
: "${SBATCH_PARTITION:=daic-eemcs-st}"
export SBATCH_ACCOUNT SBATCH_PARTITION

# Loaded after `module load 2026 cpu`.
export PYTHON_MODULE="${PYTHON_MODULE:-python/3.13.12}"

# --mem-per-cpu for the array job only (scripts/slurm/submit_sweep.sh passes it
# on; generate and aggregate keep their own values). The sbatch script's 2G was
# at its limit in the 2026-11-04 smoke test: both enhsp tasks peaked at
# 2,095,780K MaxRSS (2G is 2,097,152K), one of them after only 21 s. 8G is a
# guess for 30-minute runs, not a measurement; revisit with sacct MaxRSS.
export ARRAY_MEM_PER_CPU="${ARRAY_MEM_PER_CPU:-8G}"

# Keep every cache and the .sif files out of the 4 MiB home directory.
DAIC_BASE="$HOME/linuxhome"
export SIF_CACHE_DIR="${SIF_CACHE_DIR:-$DAIC_BASE/apptainer-images}"
export APPTAINER_CACHEDIR="${APPTAINER_CACHEDIR:-$DAIC_BASE/.apptainer-cache}"
export APPTAINER_TMPDIR="${APPTAINER_TMPDIR:-$DAIC_BASE/.apptainer-tmp}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$DAIC_BASE/.cache}"
mkdir -p "$SIF_CACHE_DIR" "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR" "$XDG_CACHE_HOME"
