{
  "$defs": {
    "CustomTrainsConfig": {
      "additionalProperties": false,
      "description": "trains_given=true: the trains are spelled out rather than drawn.\n\nThe custom_* payloads are typed only as objects for now. The value of this\nschema is at the top level, where the optional knobs live and where a typo\ngoes unnoticed; the nested shapes are involved enough to deserve their own\npass rather than a guess.",
      "properties": {
        "location": {
          "title": "Location",
          "type": "string"
        },
        "start_time": {
          "title": "Start Time",
          "type": "integer"
        },
        "end_time": {
          "title": "End Time",
          "type": "integer"
        },
        "perform_servicing": {
          "title": "Perform Servicing",
          "type": "boolean"
        },
        "intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Intent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "use_default_material": {
          "title": "Use Default Material",
          "type": "boolean"
        },
        "number_of_train_unit_types": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number Of Train Unit Types"
        },
        "custom_train_unit_types": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Train Unit Types"
        },
        "track_ids_used": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Ids Used"
        },
        "trains_given": {
          "const": true,
          "title": "Trains Given",
          "type": "boolean"
        },
        "custom_trains": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Custom Trains",
          "type": "array"
        },
        "custom_train_units": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Custom Train Units",
          "type": "array"
        },
        "custom_servicing_tasks": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Custom Servicing Tasks",
          "type": "array"
        },
        "partial_matching_given": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partial Matching Given"
        },
        "partial_plan_given": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partial Plan Given"
        },
        "through_traffic_given": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Through Traffic Given"
        }
      },
      "required": [
        "location",
        "start_time",
        "end_time",
        "perform_servicing",
        "use_default_material",
        "trains_given"
      ],
      "title": "CustomTrainsConfig",
      "type": "object"
    },
    "Gateway": {
      "additionalProperties": false,
      "description": "The track parts trains may arrive over and depart from, by name.",
      "properties": {
        "arrival": {
          "items": {
            "type": "string"
          },
          "title": "Arrival",
          "type": "array"
        },
        "departure": {
          "items": {
            "type": "string"
          },
          "title": "Departure",
          "type": "array"
        }
      },
      "title": "Gateway",
      "type": "object"
    },
    "GeneratedTrainsConfig": {
      "additionalProperties": false,
      "description": "trains_given=false: the trains are drawn from a distribution.",
      "properties": {
        "location": {
          "title": "Location",
          "type": "string"
        },
        "start_time": {
          "title": "Start Time",
          "type": "integer"
        },
        "end_time": {
          "title": "End Time",
          "type": "integer"
        },
        "perform_servicing": {
          "title": "Perform Servicing",
          "type": "boolean"
        },
        "intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Intent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "use_default_material": {
          "title": "Use Default Material",
          "type": "boolean"
        },
        "number_of_train_unit_types": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number Of Train Unit Types"
        },
        "custom_train_unit_types": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Train Unit Types"
        },
        "track_ids_used": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Ids Used"
        },
        "trains_given": {
          "const": false,
          "title": "Trains Given",
          "type": "boolean"
        },
        "number_of_trains": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number Of Trains"
        },
        "train_unit_distribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrainUnitDistribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gateway": {
          "anyOf": [
            {
              "$ref": "#/$defs/Gateway"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "matching": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matching"
        },
        "min_gap_on_gateway": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
